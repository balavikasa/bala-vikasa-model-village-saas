# Runtime
APP_TIMEZONE=Asia/Kolkata
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=replace-with-at-least-32-random-bytes
DATABASE_URL=sqlite:///model_village.db
# Production database example:
# DATABASE_URL=postgresql+psycopg://model_village:change-me@postgres:5432/model_village
# Production: set FLASK_ENV=production, SESSION_COOKIE_SECURE=1, TRUST_PROXY as required,
# and use a strong SECRET_KEY from your deployment secret manager.

# Security and proxy handling
SESSION_PROTECTION=basic
SESSION_COOKIE_SECURE=0
WTF_CSRF_TIME_LIMIT_SECONDS=43200
TRUST_PROXY=0
MAX_UPLOAD_MB=12

# Data and uploads
UPLOAD_FOLDER=uploads
MASTER_WORKBOOK=data/MV-Master-Data-26-27.xlsx
RECYCLE_RETENTION_DAYS=10

# Bootstrap (use only for the one-time command; do not commit real values)
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_MOBILE=
BOOTSTRAP_ADMIN_PASSWORD=change-this-immediately

# Docker Compose database secrets

# Local docker-compose PostgreSQL credential
POSTGRES_PASSWORD=replace-with-a-strong-database-password
