# Bala Vikasa Model Village SaaS - Coolify + PostgreSQL production runtime
# Paste these into Coolify -> Application -> Environment Variables.
# Never commit real values.

FLASK_ENV=production
APP_TIMEZONE=Asia/Kolkata

# Generate with:
# python -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=REPLACE_WITH_A_RANDOM_96_HEX_CHARACTER_SECRET

# Paste the INTERNAL URL copied from the Coolify PostgreSQL resource.
# Coolify commonly shows postgres://...; the app automatically normalizes it to
# SQLAlchemy's explicit Psycopg 3 dialect (postgresql+psycopg://...).
DATABASE_URL=postgres://model_village:REPLACE_PASSWORD@REPLACE_INTERNAL_HOST:5432/model_village

# Reverse proxy / sessions
TRUST_PROXY=1
SESSION_PROTECTION=basic
SESSION_COOKIE_SECURE=1
SESSION_HOURS=12
WTF_CSRF_TIME_LIMIT_SECONDS=43200

# Uploads and media - mount a Coolify named volume at this exact path.
UPLOAD_FOLDER=/srv/app/uploads
MAX_UPLOAD_MB=12
PHOTO_MAX_EDGE=1920
PHOTO_WEBP_QUALITY=82

# Application data / retention
MASTER_WORKBOOK=/srv/app/data/MV-Master-Data-26-27.xlsx
RECYCLE_RETENTION_DAYS=10

# Logging / Gunicorn
LOG_LEVEL=INFO
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
